# Telegram
TELEGRAM_BOT_TOKEN=1234567890:REPLACE_ME

# AITunnel
AITUNNEL_API_KEY=sk-aitunnel-REPLACE_ME
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1

# Модели. Для чата/vision можно оставить auto.
AITUNNEL_CHAT_MODEL=auto
AITUNNEL_VISION_MODEL=auto
AITUNNEL_IMAGE_MODEL=gpt-image-1

# Генерация изображений
AITUNNEL_IMAGE_SIZE=1024x1024
AITUNNEL_IMAGE_QUALITY=auto
AITUNNEL_IMAGE_FORMAT=png

# Bothost: data/ в рабочем каталоге соответствует /app/data
DATABASE_PATH=data/cakehub.sqlite3

# Память диалога
HISTORY_LIMIT=16
MAX_OUTPUT_TOKENS=2500
AI_TIMEOUT_SECONDS=180

# Группы
GROUP_TRIGGER_NAME=кейкхаб

# Логи
LOG_LEVEL=INFO
